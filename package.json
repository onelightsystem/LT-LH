{
  "name": "@olsystem/lt-lh",
  "version": "0.1.21",
  "description": "OLS Sun Light Time system — Light Hour (LH) / dark hour (dh) conversion, Proper Day counter, and embeddable widgets for the OneLightSystem Light Calendar.",
  "keywords": [
    "ols",
    "onelightsystem",
    "light-time",
    "sun-calendar",
    "light-hour",
    "proper-day",
    "widget"
  ],
  "license": "MIT",
  "author": "OneLightSystem OLS (https://www.olsme.com)",
  "homepage": "https://github.com/onelightsystem/LT-LH#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onelightsystem/LT-LH.git"
  },
  "bugs": {
    "url": "https://github.com/onelightsystem/LT-LH/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widgets/light-time": {
      "import": "./dist/widgets/ols-lighttime-widget.js",
      "types": "./dist/widgets/ols-lighttime-widget.d.ts",
      "default": "./dist/widgets/ols-lighttime-widget.global.js"
    },
    "./widgets/calendar": {
      "import": "./dist/widgets/ols-calendar-widget.js",
      "types": "./dist/widgets/ols-calendar-widget.d.ts",
      "default": "./dist/widgets/ols-calendar-widget.global.js"
    },
    "./widgets/calendar-orb": {
      "import": "./dist/widgets/calendar-orb.js",
      "types": "./dist/widgets/calendar-orb.d.ts",
      "default": "./dist/widgets/calendar-orb.global.js"
    },
    "./widgets/solar-day-arc": {
      "import": "./dist/widgets/solar-day-arc.js",
      "types": "./dist/widgets/solar-day-arc.d.ts",
      "default": "./dist/widgets/solar-day-arc.global.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:widgets": "echo 'Widgets built by tsup'",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run build:widgets"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
